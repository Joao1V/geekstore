generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id       String   @id @default(uuid(7)) @db.Uuid
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  name          String   @db.VarChar(255)
  role_id       String   @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  role           Role           @relation(fields: [role_id], references: [role_id])
  refresh_tokens RefreshToken[]
  audit_logs     AuditLog[]

  @@index([role_id])
  @@map("user")
}

model RefreshToken {
  refresh_token_id String    @id @default(uuid(7)) @db.Uuid
  user_id          String    @db.Uuid
  token_hash       String    @unique @db.Char(64)
  expires_at       DateTime
  revoked_at       DateTime?
  // Quando foi trocado por um novo (rotação). Só um token trocado ganha a janela de corrida entre abas.
  rotated_at       DateTime?
  created_at       DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_token")
}

// Perfis do admin (RF-PLA-03). O mapa perfil -> permissões vive em código
// (`packages/shared/src/rbac.ts`); aqui só a identidade do perfil.
model Role {
  role_id    String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(64)
  created_at DateTime @default(now())

  users User[]

  @@map("role")
}

enum AuditAction {
  create
  update
  delete
}

// Escrito na mesma transação da mudança (RF-PLA-04).
model AuditLog {
  audit_log_id String      @id @default(uuid(7)) @db.Uuid
  user_id      String?     @db.Uuid
  entity       String      @db.VarChar(64)
  entity_id    String      @db.Uuid
  action       AuditAction
  before       Json?
  after        Json?
  created_at   DateTime    @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([entity, entity_id])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_log")
}

enum ProductStatus {
  draft
  active
  archived
}

enum SkuStatus {
  active
  inactive
}

// Árvore de até 3 níveis (RF-CAT-05); a profundidade é validada no service.
model Category {
  category_id     String   @id @default(uuid(7)) @db.Uuid
  parent_id       String?  @db.Uuid
  name            String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  featured        Boolean  @default(false)
  position        Int      @default(0)
  seo_title       String?  @db.VarChar(255)
  seo_description String?  @db.VarChar(500)
  canonical_url   String?  @db.VarChar(500)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  parent     Category?           @relation("CategoryTree", fields: [parent_id], references: [category_id])
  children   Category[]          @relation("CategoryTree")
  products   Product[]
  attributes CategoryAttribute[]
  coupons    CouponCategory[]

  @@index([parent_id])
  @@map("category")
}

model Product {
  product_id      String        @id @default(uuid(7)) @db.Uuid
  category_id     String        @db.Uuid
  // Código do produto (ex.: CAM-NARUTO): a base dos SKUs das variações. Imutável.
  code            String        @unique @db.VarChar(40)
  name            String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(255)
  description     String?       @db.Text
  brand_id        String?       @db.Uuid
  status          ProductStatus @default(draft)
  seo_title       String?       @db.VarChar(255)
  seo_description String?       @db.VarChar(500)
  canonical_url   String?       @db.VarChar(500)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  category            Category            @relation(fields: [category_id], references: [category_id])
  brand               Brand?              @relation(fields: [brand_id], references: [brand_id])
  skus                Sku[]
  media               Media[]
  collection_products CollectionProduct[]

  @@index([category_id])
  @@index([brand_id])
  @@index([status])
  @@map("product")
}

// Unidade vendável (RF-CAT-02). Preço, estoque, anúncio e item de pedido apontam para cá.
// ---------- Clientes, pedidos e pagamento (F2/F3) ----------

// Cliente da loja: tabela própria, separada de `user` (equipe). Audiência de JWT e cookie também.
model Customer {
  customer_id   String   @id @default(uuid(7)) @db.Uuid
  email         String   @unique @db.VarChar(255)
  name          String   @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  // CPF ou CNPJ, só dígitos.
  document      String?  @db.VarChar(14)
  phone         String?  @db.VarChar(20)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  addresses      Address[]
  refresh_tokens CustomerRefreshToken[]
  orders         Order[]

  @@map("customer")
}

model CustomerRefreshToken {
  customer_refresh_token_id String    @id @default(uuid(7)) @db.Uuid
  customer_id               String    @db.Uuid
  token_hash                String    @unique @db.Char(64)
  expires_at                DateTime
  revoked_at                DateTime?
  rotated_at                DateTime?
  created_at                DateTime  @default(now())

  customer Customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_refresh_token")
}

model Address {
  address_id   String   @id @default(uuid(7)) @db.Uuid
  customer_id  String   @db.Uuid
  recipient    String   @db.VarChar(255)
  // CEP, só dígitos.
  zip          String   @db.VarChar(8)
  street       String   @db.VarChar(255)
  number       String   @db.VarChar(20)
  complement   String?  @db.VarChar(120)
  neighborhood String   @db.VarChar(120)
  city         String   @db.VarChar(120)
  state        String   @db.VarChar(2)
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)

  @@index([customer_id])
  @@map("address")
}

// Três estados independentes (RF-PED-02): pedido, pagamento e entrega.
enum OrderStatus {
  open
  completed
  cancelled
}

enum PaymentStatus {
  pending
  approved
  partially_refunded
  refunded
}

enum FulfillmentStatus {
  not_picked
  picking
  partially_shipped
  shipped
  delivered
}

// O pedido congela valores, endereço e nome/código de cada SKU na compra. Único por canal e
// externalOrderId; a chave de idempotência impede pedido duplicado por clique repetido (RF-PED-08).
model Order {
  order_id           String            @id @default(uuid(7)) @db.Uuid
  // Número legível e sequencial (começa em 1001 pela migração).
  number             Int               @unique @default(autoincrement())
  channel_id         String            @db.Uuid
  external_order_id  String?           @db.VarChar(64)
  customer_id        String?           @db.Uuid
  contact_name       String            @db.VarChar(255)
  contact_email      String            @db.VarChar(255)
  contact_phone      String?           @db.VarChar(20)
  contact_document   String?           @db.VarChar(14)
  status             OrderStatus       @default(open)
  payment_status     PaymentStatus     @default(pending)
  fulfillment_status FulfillmentStatus @default(not_picked)
  subtotal_cents     Int
  shipping_cents     Int
  discount_cents     Int               @default(0)
  total_cents        Int
  coupon_code        String?           @db.VarChar(40)
  // Endereço de entrega no momento da compra (não muda se o cliente editar o cadastro).
  shipping_address   Json
  shipping_service   String            @db.VarChar(80)
  idempotency_key    String            @unique @db.VarChar(128)
  cancel_reason      String?           @db.VarChar(255)
  cancelled_at       DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  channel   Channel     @relation(fields: [channel_id], references: [channel_id])
  customer  Customer?   @relation(fields: [customer_id], references: [customer_id])
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]

  @@unique([channel_id, external_order_id])
  @@index([customer_id, created_at])
  @@index([status, created_at])
  @@map("order")
}

model OrderItem {
  order_item_id    String  @id @default(uuid(7)) @db.Uuid
  order_id         String  @db.Uuid
  sku_id           String  @db.Uuid
  // Código e nome do SKU no momento da compra: o pedido não muda se o catálogo mudar.
  sku_code         String  @db.VarChar(64)
  name             String  @db.VarChar(255)
  variant          String? @db.VarChar(255)
  image_url        String? @db.VarChar(500)
  unit_price_cents Int
  quantity         Int
  total_cents      Int

  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  sku   Sku   @relation(fields: [sku_id], references: [sku_id])

  @@index([order_id])
  @@index([sku_id])
  @@map("order_item")
}

enum PaymentMethod {
  pix
  card
  boleto
}

enum PaymentAttemptStatus {
  pending
  approved
  declined
  expired
}

// Várias tentativas por pedido (RF-PAG-09); o estado de pagamento do pedido muda pela aprovada.
model Payment {
  payment_id   String               @id @default(uuid(7)) @db.Uuid
  order_id     String               @db.Uuid
  provider     String               @db.VarChar(32)
  external_id  String               @db.VarChar(100)
  method       PaymentMethod
  status       PaymentAttemptStatus @default(pending)
  amount_cents Int
  installments Int                  @default(1)
  // O que a tela precisa mostrar: código Pix, linha do boleto, final do cartão. Nunca dado de cartão.
  details      Json?
  expires_at   DateTime?
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt

  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@unique([provider, external_id])
  @@index([order_id])
  @@map("payment")
}

// Recebimento durável de webhook (RF-PAG-08): registrado antes de aplicar, único por provedor e id
// do evento, então reenvio não repete o efeito (RF-PAG-04).
model WebhookEvent {
  webhook_event_id String    @id @default(uuid(7)) @db.Uuid
  provider         String    @db.VarChar(32)
  event_id         String    @db.VarChar(100)
  resource_id      String?   @db.VarChar(100)
  state            String    @db.VarChar(16)
  payload          Json
  error            String?   @db.VarChar(500)
  created_at       DateTime  @default(now())
  processed_at     DateTime?

  @@unique([provider, event_id])
  @@map("webhook_event")
}

enum ShipmentStatus {
  pending
  shipped
  delivered
}

model Shipment {
  shipment_id   String         @id @default(uuid(7)) @db.Uuid
  order_id      String         @db.Uuid
  carrier       String         @db.VarChar(60)
  service       String         @db.VarChar(80)
  tracking_code String?        @db.VarChar(60)
  status        ShipmentStatus @default(pending)
  shipped_at    DateTime?
  delivered_at  DateTime?
  created_at    DateTime       @default(now())

  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@map("shipment")
}

enum CouponKind {
  percent
  amount
  free_shipping
}

model Coupon {
  coupon_id          String     @id @default(uuid(7)) @db.Uuid
  code               String     @unique @db.VarChar(40)
  kind               CouponKind
  // percent: 1 a 100; amount: centavos; free_shipping: ignorado.
  value              Int        @default(0)
  min_subtotal_cents Int        @default(0)
  max_uses           Int?
  uses               Int        @default(0)
  starts_at          DateTime?
  ends_at            DateTime?
  is_active          Boolean    @default(true)
  created_at         DateTime   @default(now())

  categories CouponCategory[]

  @@map("coupon")
}

// Restringe o cupom a categorias (vale também nas subcategorias). Sem nenhuma linha, vale para o carrinho
// todo. `onDelete: Restrict` na categoria: apagar a categoria não pode "soltar" a restrição sem ninguém ver.
model CouponCategory {
  coupon_category_id String   @id @default(uuid(7)) @db.Uuid
  coupon_id          String   @db.Uuid
  category_id        String   @db.Uuid
  created_at         DateTime @default(now())

  coupon   Coupon   @relation(fields: [coupon_id], references: [coupon_id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [category_id], onDelete: Restrict)

  @@unique([coupon_id, category_id])
  @@index([category_id])
  @@map("coupon_category")
}

// ---------- Compras: nota de entrada (NF-e do fornecedor) que alimenta o estoque ----------

enum PurchaseReceiptStatus {
  draft
  posted
}

enum ReceiptMatchMethod {
  mapping
  ean
  manual
}

// Fornecedor (quem emite a nota de compra). O CNPJ, só dígitos, identifica.
model Supplier {
  supplier_id String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(255)
  document    String?  @unique @db.VarChar(14)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  receipts      PurchaseReceipt[]
  supplier_skus SupplierSku[]

  @@map("supplier")
}

// Nota de entrada. A chave de acesso (44 dígitos) é única: a mesma nota nunca é lançada duas vezes.
// Rascunho não mexe no estoque; só `posted` (lançada) gera as entradas no livro-razão.
model PurchaseReceipt {
  purchase_receipt_id String                @id @default(uuid(7)) @db.Uuid
  supplier_id         String?               @db.Uuid
  number              String?               @db.VarChar(20)
  series              String?               @db.VarChar(5)
  access_key          String?               @unique @db.VarChar(44)
  issued_at           DateTime?
  total_cents         Int
  location_id         String                @db.Uuid
  status              PurchaseReceiptStatus @default(draft)
  notes               String?               @db.Text
  // XML original da NF-e, guardado para auditoria e reprocessamento.
  xml                 String?               @db.Text
  posted_at           DateTime?
  posted_by           String?               @db.Uuid
  created_by          String?               @db.Uuid
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt

  supplier Supplier?             @relation(fields: [supplier_id], references: [supplier_id])
  location Location              @relation(fields: [location_id], references: [location_id])
  items    PurchaseReceiptItem[]

  @@index([supplier_id])
  @@index([status, created_at])
  @@map("purchase_receipt")
}

model PurchaseReceiptItem {
  purchase_receipt_item_id String              @id @default(uuid(7)) @db.Uuid
  purchase_receipt_id      String              @db.Uuid
  line                     Int
  supplier_code            String?             @db.VarChar(60)
  description              String              @db.VarChar(500)
  ean                      String?             @db.VarChar(14)
  ncm                      String?             @db.VarChar(8)
  quantity                 Int
  unit_cost_cents          Int
  total_cost_cents         Int
  sku_id                   String?             @db.Uuid
  match_method             ReceiptMatchMethod?
  // Item que não entra no estoque (frete, brinde, embalagem).
  ignored                  Boolean             @default(false)

  receipt PurchaseReceipt @relation(fields: [purchase_receipt_id], references: [purchase_receipt_id], onDelete: Cascade)
  sku     Sku?            @relation(fields: [sku_id], references: [sku_id])

  @@unique([purchase_receipt_id, line])
  @@index([sku_id])
  @@map("purchase_receipt_item")
}

// Memória do que já foi ligado: o código do fornecedor aponta para um SKU nosso, então a próxima nota
// do mesmo fornecedor já vem casada.
model SupplierSku {
  supplier_sku_id String   @id @default(uuid(7)) @db.Uuid
  supplier_id     String   @db.Uuid
  supplier_code   String   @db.VarChar(60)
  sku_id          String   @db.Uuid
  created_at      DateTime @default(now())

  supplier Supplier @relation(fields: [supplier_id], references: [supplier_id], onDelete: Cascade)
  sku      Sku      @relation(fields: [sku_id], references: [sku_id], onDelete: Cascade)

  @@unique([supplier_id, supplier_code])
  @@index([sku_id])
  @@map("supplier_sku")
}

// Contador de numeração dos códigos de SKU por tipo (CNC, CAM, FNK...). A numeração só avança: o
// código nunca é reaproveitado, então dois produtos não podem receber o mesmo número (o UNIQUE de
// `sku.code` é a trava final).
model SkuSequence {
  prefix     String   @id @db.VarChar(8)
  last_value Int      @default(0)
  updated_at DateTime @updatedAt

  @@map("sku_sequence")
}

model Sku {
  sku_id             String    @id @default(uuid(7)) @db.Uuid
  product_id         String    @db.Uuid
  code               String    @unique @db.VarChar(64) // imutável: o service rejeita alteração
  ean                String?   @db.VarChar(14)
  weight_g           Int?
  length_mm          Int?
  width_mm           Int?
  height_mm          Int?
  ncm                String?   @db.VarChar(8)
  // Código do fabricante (MPN): os marketplaces e o Google Merchant pedem junto da marca.
  manufacturer_code  String?   @db.VarChar(60)
  cost_cents         Int?
  status             SkuStatus @default(active)
  // Código do item no sistema de origem (ERP): chave da importação, que a torna repetível, e elo
  // de conferência com a base antiga. Anulável: SKUs criados no admin não têm legado.
  legacy_code        String?   @unique @db.VarChar(32)
  // Linha original do ERP (campos sem coluna própria), para auditoria da migração.
  legacy_data        Json?
  // Preenchido quando este SKU era duplicata de outro e foi mesclado: o estoque foi transferido para
  // `merged_into` e este fica inativo, mas conserva o `legacy_code` (a integração e a reimportação
  // do ERP continuam reconhecendo o código antigo).
  merged_into_sku_id String?   @db.Uuid
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  product          Product               @relation(fields: [product_id], references: [product_id])
  merged_into      Sku?                  @relation("SkuMerge", fields: [merged_into_sku_id], references: [sku_id])
  merged_from      Sku[]                 @relation("SkuMerge")
  media            Media[]
  stock_levels     StockLevel[]
  receipt_items    PurchaseReceiptItem[]
  supplier_skus    SupplierSku[]
  order_items      OrderItem[]
  movements        StockMovement[]
  reservations     StockReservation[]
  prices           Price[]
  attribute_values SkuAttributeValue[]

  @@index([product_id])
  @@index([ean])
  @@index([merged_into_sku_id])
  @@map("sku")
}

enum CollectionKind {
  franchise
  curated
}

// Franquia/universo (Star Wars, Marvel) e curadoria manual ("Novos Drops") — mesma entidade.
model Collection {
  collection_id String         @id @default(uuid(7)) @db.Uuid
  name          String         @db.VarChar(255)
  slug          String         @unique @db.VarChar(255)
  kind          CollectionKind @default(franchise)
  description   String?        @db.Text
  featured      Boolean        @default(false)
  position      Int            @default(0)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  products CollectionProduct[]

  @@map("collection")
}

model CollectionProduct {
  collection_product_id String   @id @default(uuid(7)) @db.Uuid
  collection_id         String   @db.Uuid
  product_id            String   @db.Uuid
  position              Int      @default(0)
  created_at            DateTime @default(now())

  collection Collection @relation(fields: [collection_id], references: [collection_id], onDelete: Cascade)
  product    Product    @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([collection_id, product_id])
  @@index([product_id])
  @@map("collection_product")
}

// Imagem no bucket, servida via CDN (D10). `sku_id` preenchido = imagem específica da variação.
model Media {
  media_id   String   @id @default(uuid(7)) @db.Uuid
  product_id String   @db.Uuid
  sku_id     String?  @db.Uuid
  url        String   @db.VarChar(500)
  alt        String   @db.VarChar(255)
  position   Int      @default(0)
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  sku     Sku?    @relation(fields: [sku_id], references: [sku_id], onDelete: SetNull)

  @@index([product_id, position])
  @@index([sku_id])
  @@map("media")
}

enum LocationType {
  warehouse
  store
  quarantine // devolução sem condição de venda: não entra no disponível vendável (RF-PED-04)
}

model Location {
  location_id String       @id @default(uuid(7)) @db.Uuid
  name        String       @db.VarChar(120)
  type        LocationType @default(warehouse)
  created_at  DateTime     @default(now())

  stock_levels StockLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  receipts     PurchaseReceipt[]

  @@map("location")
}

// Saldo por SKU e local. `on_hand` = físico; `reserved` = comprometido; disponível = on_hand - reserved.
// CHECK (on_hand >= 0 AND reserved >= 0 AND reserved <= on_hand) vive no SQL da migração (RNF-09).
model StockLevel {
  stock_level_id String   @id @default(uuid(7)) @db.Uuid
  sku_id         String   @db.Uuid
  location_id    String   @db.Uuid
  on_hand        Int      @default(0)
  reserved       Int      @default(0)
  updated_at     DateTime @updatedAt

  sku      Sku      @relation(fields: [sku_id], references: [sku_id])
  location Location @relation(fields: [location_id], references: [location_id])

  @@unique([sku_id, location_id])
  @@index([location_id])
  @@map("stock_level")
}

enum StockMovementType {
  inbound
  outbound
  adjustment
  reservation
  release
  return
}

// Livro-razão: só recebe inserções. `quantity` é o delta com sinal aplicado à coluna afetada
// (`on_hand` em inbound/outbound/adjustment/return; `reserved` em reservation/release).
model StockMovement {
  stock_movement_id String            @id @default(uuid(7)) @db.Uuid
  sku_id            String            @db.Uuid
  location_id       String            @db.Uuid
  type              StockMovementType
  quantity          Int
  reason            String?           @db.VarChar(255)
  reference_type    String?           @db.VarChar(32)
  reference_id      String?           @db.Uuid
  user_id           String?           @db.Uuid
  created_at        DateTime          @default(now())

  sku      Sku      @relation(fields: [sku_id], references: [sku_id])
  location Location @relation(fields: [location_id], references: [location_id])

  @@index([sku_id, location_id, created_at])
  @@index([reference_type, reference_id])
  @@map("stock_movement")
}

enum StockReservationStatus {
  active
  committed
  consumed
  released
  expired
}

// Só o desenho na F1; o checkout que cria a reserva é da F3 (RF-EST-03).
model StockReservation {
  stock_reservation_id String                 @id @default(uuid(7)) @db.Uuid
  sku_id               String                 @db.Uuid
  location_id          String                 @db.Uuid
  quantity             Int
  checkout_id          String?                @db.Uuid
  order_id             String?                @db.Uuid
  status               StockReservationStatus @default(active)
  expires_at           DateTime
  idempotency_key      String                 @unique @db.VarChar(128)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  sku      Sku      @relation(fields: [sku_id], references: [sku_id])
  location Location @relation(fields: [location_id], references: [location_id])

  @@index([sku_id, location_id])
  @@index([status, expires_at])
  @@map("stock_reservation")
}

// Canais: site, ml, shopee. Credenciais cifradas entram na F5.
model Channel {
  channel_id            String   @id @default(uuid(7)) @db.Uuid
  code                  String   @unique @db.VarChar(32)
  name                  String   @db.VarChar(64)
  is_active             Boolean  @default(true)
  credentials_encrypted String?  @db.Text
  created_at            DateTime @default(now())

  prices Price[]
  orders Order[]

  @@map("channel")
}

// Preço por SKU, canal e vigência. O vigente é o de maior `starts_at` <= agora e sem `ends_at` vencido.
model Price {
  price_id         String    @id @default(uuid(7)) @db.Uuid
  sku_id           String    @db.Uuid
  channel_id       String    @db.Uuid
  price_cents      Int
  compare_at_cents Int? // valor "de" (RF-PRE-02, F3)
  starts_at        DateTime  @default(now())
  ends_at          DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  sku     Sku     @relation(fields: [sku_id], references: [sku_id])
  channel Channel @relation(fields: [channel_id], references: [channel_id])

  @@unique([sku_id, channel_id, starts_at])
  @@index([channel_id])
  @@map("price")
}

// ── Atributos de variação (cor, tamanho...) ──────────────────────────────────
// O atributo é cadastrado uma vez, tem valores controlados e é ligado às categorias que o usam.
// Cada SKU aponta para UM valor por atributo (cor = Preto, tamanho = GG).

model Attribute {
  attribute_id String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique @db.VarChar(40) // snake_case, estável: "cor", "tamanho"
  name         String   @db.VarChar(80)
  position     Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  values     AttributeValue[]
  categories CategoryAttribute[]
  sku_values SkuAttributeValue[]

  @@map("attribute")
}

model AttributeValue {
  attribute_value_id String   @id @default(uuid(7)) @db.Uuid
  attribute_id       String   @db.Uuid
  code               String   @db.VarChar(60) // "preto", "gg", "36-38"
  label              String   @db.VarChar(80) // "Preto", "GG", "36/38"
  sku_suffix         String   @db.VarChar(12) // final do SKU: AZ, GG, 33-35 (CAM-01 + AZ + M)
  is_active          Boolean  @default(true)
  position           Int      @default(0) // ordem de exibição (P antes de M antes de G)
  color_hex          String?  @db.VarChar(7) // amostra visual, só para cor
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  attribute  Attribute           @relation(fields: [attribute_id], references: [attribute_id])
  sku_values SkuAttributeValue[]

  @@unique([attribute_id, code])
  @@unique([attribute_id, sku_suffix])
  @@map("attribute_value")
}

// Quais atributos uma categoria pede. As subcategorias herdam os da categoria-mãe.
model CategoryAttribute {
  category_attribute_id String  @id @default(uuid(7)) @db.Uuid
  category_id           String  @db.Uuid
  attribute_id          String  @db.Uuid
  is_required           Boolean @default(true)
  position              Int     @default(0)

  category  Category  @relation(fields: [category_id], references: [category_id])
  attribute Attribute @relation(fields: [attribute_id], references: [attribute_id])

  @@unique([category_id, attribute_id])
  @@map("category_attribute")
}

model SkuAttributeValue {
  sku_attribute_value_id String @id @default(uuid(7)) @db.Uuid
  sku_id                 String @db.Uuid
  attribute_id           String @db.Uuid
  attribute_value_id     String @db.Uuid

  sku       Sku            @relation(fields: [sku_id], references: [sku_id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attribute_id], references: [attribute_id])
  value     AttributeValue @relation(fields: [attribute_value_id], references: [attribute_value_id])

  // Um valor por atributo em cada SKU; o índice do valor serve ao filtro da vitrine (cor = Preto).
  @@unique([sku_id, attribute_id])
  @@index([attribute_value_id])
  @@map("sku_attribute_value")
}

model Brand {
  brand_id   String   @id @default(uuid(7)) @db.Uuid
  name       String   @unique @db.VarChar(120)
  slug       String   @unique @db.VarChar(140)
  is_active  Boolean  @default(true)
  logo_url   String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]

  @@map("brand")
}

// Grupos de possíveis duplicados que o operador marcou como "são produtos diferentes". A chave é o
// hash dos SKUs do grupo: se entrar um item novo, o grupo muda de chave e volta a ser sugerido.
model DuplicateDismissal {
  duplicate_dismissal_id String   @id @default(uuid(7)) @db.Uuid
  group_key              String   @unique @db.VarChar(64)
  user_id                String?  @db.Uuid
  created_at             DateTime @default(now())

  @@map("duplicate_dismissal")
}

// ---------- Conteúdo da loja: páginas institucionais (Markdown) ----------

enum PageStatus {
  draft
  published
}

// Página institucional (trocas e devoluções, nos conheça, contato...). O corpo é Markdown; só `published`
// aparece na loja, em /pagina/<slug>.
model Page {
  page_id         String     @id @default(uuid(7)) @db.Uuid
  slug            String     @unique @db.VarChar(120)
  title           String     @db.VarChar(255)
  body            String     @default("") @db.Text
  status          PageStatus @default(draft)
  seo_title       String?    @db.VarChar(255)
  seo_description String?    @db.VarChar(500)
  // Ordem dos links no rodapé da loja.
  position        Int        @default(0)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  @@map("page")
}
