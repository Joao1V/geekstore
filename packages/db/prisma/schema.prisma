generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
}

model User {
  user_id       String   @id @default(uuid(7)) @db.Char(36)
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  name          String   @db.VarChar(255)
  role_id       String   @db.Char(36)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  role           Role           @relation(fields: [role_id], references: [role_id])
  refresh_tokens RefreshToken[]
  audit_logs     AuditLog[]

  @@index([role_id])
  @@map("user")
}

model RefreshToken {
  refresh_token_id String    @id @default(uuid(7)) @db.Char(36)
  user_id          String    @db.Char(36)
  token_hash       String    @unique @db.Char(64)
  expires_at       DateTime
  revoked_at       DateTime?
  created_at       DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_token")
}

// Perfis do admin (RF-PLA-03). O mapa perfil -> permissões vive em código
// (`packages/shared/src/rbac.ts`); aqui só a identidade do perfil.
model Role {
  role_id    String   @id @default(uuid(7)) @db.Char(36)
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(64)
  created_at DateTime @default(now())

  users User[]

  @@map("role")
}

enum AuditAction {
  create
  update
  delete
}

// Escrito na mesma transação da mudança (RF-PLA-04).
model AuditLog {
  audit_log_id String      @id @default(uuid(7)) @db.Char(36)
  user_id      String?     @db.Char(36)
  entity       String      @db.VarChar(64)
  entity_id    String      @db.Char(36)
  action       AuditAction
  before       Json?
  after        Json?
  created_at   DateTime    @default(now())

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([entity, entity_id])
  @@index([user_id])
  @@index([created_at])
  @@map("audit_log")
}

enum ProductStatus {
  draft
  active
  archived
}

enum SkuStatus {
  active
  inactive
}

// Árvore de até 3 níveis (RF-CAT-05); a profundidade é validada no service.
model Category {
  category_id     String   @id @default(uuid(7)) @db.Char(36)
  parent_id       String?  @db.Char(36)
  name            String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  featured        Boolean  @default(false)
  position        Int      @default(0)
  seo_title       String?  @db.VarChar(255)
  seo_description String?  @db.VarChar(500)
  canonical_url   String?  @db.VarChar(500)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [category_id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parent_id])
  @@map("category")
}

model Product {
  product_id      String        @id @default(uuid(7)) @db.Char(36)
  category_id     String        @db.Char(36)
  name            String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(255)
  description     String?       @db.Text
  brand           String?       @db.VarChar(120)
  status          ProductStatus @default(draft)
  seo_title       String?       @db.VarChar(255)
  seo_description String?       @db.VarChar(500)
  canonical_url   String?       @db.VarChar(500)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  category            Category            @relation(fields: [category_id], references: [category_id])
  skus                Sku[]
  media               Media[]
  collection_products CollectionProduct[]

  @@index([category_id])
  @@index([status])
  @@map("product")
}

// Unidade vendável (RF-CAT-02). Preço, estoque, anúncio e item de pedido apontam para cá.
model Sku {
  sku_id     String    @id @default(uuid(7)) @db.Char(36)
  product_id String    @db.Char(36)
  code       String    @unique @db.VarChar(64) // imutável: o service rejeita alteração
  ean        String?   @db.VarChar(14)
  attributes Json // ex.: { "cor": "azul", "edicao": "chase" }
  weight_g   Int?
  length_mm  Int?
  width_mm   Int?
  height_mm  Int?
  ncm        String?   @db.VarChar(8)
  cost_cents Int?
  status     SkuStatus @default(active)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  product      Product            @relation(fields: [product_id], references: [product_id])
  media        Media[]
  stock_levels StockLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  prices       Price[]

  @@index([product_id])
  @@index([ean])
  @@map("sku")
}

enum CollectionKind {
  franchise
  curated
}

// Franquia/universo (Star Wars, Marvel) e curadoria manual ("Novos Drops") — mesma entidade.
model Collection {
  collection_id String         @id @default(uuid(7)) @db.Char(36)
  name          String         @db.VarChar(255)
  slug          String         @unique @db.VarChar(255)
  kind          CollectionKind @default(franchise)
  description   String?        @db.Text
  featured      Boolean        @default(false)
  position      Int            @default(0)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  products CollectionProduct[]

  @@map("collection")
}

model CollectionProduct {
  collection_product_id String   @id @default(uuid(7)) @db.Char(36)
  collection_id         String   @db.Char(36)
  product_id            String   @db.Char(36)
  position              Int      @default(0)
  created_at            DateTime @default(now())

  collection Collection @relation(fields: [collection_id], references: [collection_id], onDelete: Cascade)
  product    Product    @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([collection_id, product_id])
  @@index([product_id])
  @@map("collection_product")
}

// Imagem no bucket, servida via CDN (D10). `sku_id` preenchido = imagem específica da variação.
model Media {
  media_id   String   @id @default(uuid(7)) @db.Char(36)
  product_id String   @db.Char(36)
  sku_id     String?  @db.Char(36)
  url        String   @db.VarChar(500)
  alt        String   @db.VarChar(255)
  position   Int      @default(0)
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  sku     Sku?    @relation(fields: [sku_id], references: [sku_id], onDelete: SetNull)

  @@index([product_id, position])
  @@index([sku_id])
  @@map("media")
}

enum LocationType {
  warehouse
  store
  quarantine // devolução sem condição de venda: não entra no disponível vendável (RF-PED-04)
}

model Location {
  location_id String       @id @default(uuid(7)) @db.Char(36)
  name        String       @db.VarChar(120)
  type        LocationType @default(warehouse)
  created_at  DateTime     @default(now())

  stock_levels StockLevel[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@map("location")
}

// Saldo por SKU e local. `on_hand` = físico; `reserved` = comprometido; disponível = on_hand - reserved.
// CHECK (on_hand >= 0 AND reserved >= 0 AND reserved <= on_hand) vive no SQL da migração (RNF-09).
model StockLevel {
  stock_level_id String   @id @default(uuid(7)) @db.Char(36)
  sku_id         String   @db.Char(36)
  location_id    String   @db.Char(36)
  on_hand        Int      @default(0)
  reserved       Int      @default(0)
  updated_at     DateTime @updatedAt

  sku      Sku      @relation(fields: [sku_id], references: [sku_id])
  location Location @relation(fields: [location_id], references: [location_id])

  @@unique([sku_id, location_id])
  @@index([location_id])
  @@map("stock_level")
}

enum StockMovementType {
  inbound
  outbound
  adjustment
  reservation
  release
  return
}

// Livro-razão: só recebe inserções. `quantity` é o delta com sinal aplicado à coluna afetada
// (`on_hand` em inbound/outbound/adjustment/return; `reserved` em reservation/release).
model StockMovement {
  stock_movement_id String            @id @default(uuid(7)) @db.Char(36)
  sku_id            String            @db.Char(36)
  location_id       String            @db.Char(36)
  type              StockMovementType
  quantity          Int
  reason            String?           @db.VarChar(255)
  reference_type    String?           @db.VarChar(32)
  reference_id      String?           @db.Char(36)
  user_id           String?           @db.Char(36)
  created_at        DateTime          @default(now())

  sku      Sku      @relation(fields: [sku_id], references: [sku_id])
  location Location @relation(fields: [location_id], references: [location_id])

  @@index([sku_id, location_id, created_at])
  @@index([reference_type, reference_id])
  @@map("stock_movement")
}

enum StockReservationStatus {
  active
  committed
  consumed
  released
  expired
}

// Só o desenho na F1; o checkout que cria a reserva é da F3 (RF-EST-03).
model StockReservation {
  stock_reservation_id String                 @id @default(uuid(7)) @db.Char(36)
  sku_id               String                 @db.Char(36)
  location_id          String                 @db.Char(36)
  quantity             Int
  checkout_id          String?                @db.Char(36)
  order_id             String?                @db.Char(36)
  status               StockReservationStatus @default(active)
  expires_at           DateTime
  idempotency_key      String                 @unique @db.VarChar(128)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  sku      Sku      @relation(fields: [sku_id], references: [sku_id])
  location Location @relation(fields: [location_id], references: [location_id])

  @@index([sku_id, location_id])
  @@index([status, expires_at])
  @@map("stock_reservation")
}

// Canais: site, ml, shopee. Credenciais cifradas entram na F5.
model Channel {
  channel_id            String   @id @default(uuid(7)) @db.Char(36)
  code                  String   @unique @db.VarChar(32)
  name                  String   @db.VarChar(64)
  is_active             Boolean  @default(true)
  credentials_encrypted String?  @db.Text
  created_at            DateTime @default(now())

  prices Price[]

  @@map("channel")
}

// Preço por SKU, canal e vigência. O vigente é o de maior `starts_at` <= agora e sem `ends_at` vencido.
model Price {
  price_id         String    @id @default(uuid(7)) @db.Char(36)
  sku_id           String    @db.Char(36)
  channel_id       String    @db.Char(36)
  price_cents      Int
  compare_at_cents Int? // valor "de" (RF-PRE-02, F3)
  starts_at        DateTime  @default(now())
  ends_at          DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  sku     Sku     @relation(fields: [sku_id], references: [sku_id])
  channel Channel @relation(fields: [channel_id], references: [channel_id])

  @@unique([sku_id, channel_id, starts_at])
  @@index([channel_id])
  @@map("price")
}
