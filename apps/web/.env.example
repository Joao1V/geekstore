# URL da API na rede interna, lida só pelo servidor do Next (rewrite /api e prefetch em RSC).
API_INTERNAL_URL=http://localhost:3333

# Entrar com Google (opcional): o mesmo Client ID da API. Sem ele o botão não aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Mercado Pago (opcional): a chave pública (APP_USR-... ou TEST-...) das credenciais da aplicação. Sem ela
# o checkout usa o pagamento simulado. A API precisa de PAYMENT_PROVIDER=mercadopago para cobrar de verdade.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
