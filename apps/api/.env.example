PORT=3333
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
# Proxies confiáveis na frente da API (0 = acesso direto). Com o rewrite do Next em produção: 1
# (+1 por Traefik/Cloudflare na frente do Next). Ver comentário em core/config/env.ts.
TRUST_PROXY_HOPS=0
DATABASE_URL="mysql://geekstore:geekstore@localhost:3306/geekstore"

# Gere valores reais com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=

# docker compose usa a porta 6381 localmente (6379/6380 já ocupadas por outros projetos)
REDIS_URL=redis://localhost:6381
