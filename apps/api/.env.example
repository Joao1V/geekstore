PORT=3333
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
# Proxies confiáveis na frente da API (0 = acesso direto). Com o rewrite do Next em produção: 1
# (+1 por Traefik/Cloudflare na frente do Next). Ver comentário em core/config/env.ts.
TRUST_PROXY_HOPS=0
DATABASE_URL="postgresql://geekstore:geekstore@localhost:5434/geekstore"

# Gere valores reais com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=

# docker compose usa a porta 6381 localmente (6379/6380 já ocupadas por outros projetos)
REDIS_URL=redis://localhost:6381

# Bucket S3-compatível para imagens (opcional: sem isso o upload de imagem responde erro claro).
# Dev: MinIO do docker compose (API em 9100, console em 9101; bucket `geekstore-media` criado
# automaticamente e com leitura pública anônima). Produção: Cloudflare R2.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=geekstore-media
S3_ACCESS_KEY_ID=geekstore
S3_SECRET_ACCESS_KEY=geekstore-minio-dev
S3_PUBLIC_BASE_URL=http://localhost:9100/geekstore-media

# IA (opcional): sugere o SKU dos itens da nota de entrada. Sem a chave, o botão "Perguntar à IA" fica indisponível.
ANTHROPIC_API_KEY=

# Entrar com Google (opcional): Client ID do OAuth (tipo Web). Sem ele o botão não aparece.
GOOGLE_CLIENT_ID=

# Frete real pelo Melhor Envio (Correios, Jadlog, Loggi...). Sem o token a loja usa uma estimativa por
# região, marcada como "estimativa" na tela. Token em melhorenvio.com.br > Integrações > Tokens
# (sandbox: sandbox.melhorenvio.com.br, com MELHOR_ENVIO_ENV=sandbox).
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENV=production
MELHOR_ENVIO_CONTACT_EMAIL=
# CEP de origem das encomendas (Barretos – SP).
STORE_ZIP=14780000

# Pagamento: `mock` (simulado, padrão) ou `mercadopago`. Com `mercadopago` o access token e o segredo do
# webhook são obrigatórios (mercadopago.com.br/developers > Suas integrações > Credenciais / Webhooks).
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública (https) da API; o Mercado Pago avisa os pagamentos em <API_PUBLIC_URL>/api/webhooks/mercadopago
API_PUBLIC_URL=
