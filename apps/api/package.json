    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
