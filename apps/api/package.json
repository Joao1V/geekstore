    "link:legacy": "tsx src/cli/link-legacy.ts",
    "export:depara": "tsx src/cli/export-depara.ts",
    "consolidate:catalog": "tsx src/cli/consolidate-catalog.ts",
    "ai:export": "tsx src/cli/ai-export.ts",
    "ai:import": "tsx src/cli/ai-import.ts",
    "ai:compare": "tsx src/cli/ai-compare.ts",
    "ai:apply": "tsx src/cli/ai-apply.ts",
    "ai:cleanup": "tsx src/cli/ai-cleanup.ts",
    "ai:sample": "tsx src/cli/ai-sample.ts",
    "ai:report": "tsx src/cli/ai-report.ts"
